# Copy this file to ".env" and fill in the values. Never commit your real .env.

# Postgres connection string (REQUIRED). This is your database.
# - Supabase (hosted, for production): Dashboard → Connect → "Transaction pooler"
#   URI (host ends in ...pooler.supabase.com, port 6543). Put your DB password in.
#   Example: postgresql://postgres.abcdxyz:YOUR-PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres
# - Local Postgres (for development): postgresql://postgres:PASSWORD@localhost:5432/twelve
DATABASE_URL=

# Port the API/server runs on locally (default 3001). Ignored on Vercel.
PORT=3001

# Secret used to sign session tokens.
# Locally: leave blank to auto-generate one (saved to server/data/.jwt-secret).
# On Vercel: you MUST set a long random string here (otherwise everyone gets
# logged out on every cold start). Generate one, e.g.:  openssl rand -hex 32
JWT_SECRET=

# Google Sign-In (optional). Email/password works without this.
# Create a FREE OAuth Client ID at https://console.cloud.google.com/apis/credentials
#   - Application type: "Web application"
#   - Authorized JavaScript origins: http://localhost:5173  AND  http://localhost:3001
#     (add your Vercel URL too once deployed, e.g. https://your-app.vercel.app)
# Then paste the Client ID into BOTH lines below (same value):
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# Session cookie: set to "true" when serving over HTTPS. Locally use "false";
# on Vercel (HTTPS) set it to "true" so the login cookie is sent.
COOKIE_SECURE=false

# Invite-only signup. When set, creating an account requires this exact code
# (an "access code" you hand out). Leave blank to allow open signups.
# Change it any time in Vercel's env vars — no redeploy needed.
SIGNUP_CODE=
