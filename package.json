{
  "name": "twelve",
  "private": true,
  "version": "1.0.0",
  "description": "twelve — a subscription-access marketplace prototype. Access more. Subscribe less.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n WEB,API -c cyan,magenta \"vite\" \"node --watch server/index.js\"",
